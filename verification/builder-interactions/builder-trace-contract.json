  "unmodeledEventPolicy": {
    "BeginApply(rejected)": "A rejected beginApply is a no-op by contract; ownership and preview state must remain unchanged. Covered by lifecycle beginApply acceptance schedules.",
    "LatePreviewCompleteIgnored": "A preview settlement from an older owner or draft is ignored; it cannot satisfy the current preview. Covered by late-preview schedules in BuilderPreview.tla.",
    "LateProposalCompleteIgnored": "A proposal settlement from an older generation or replaced owner is ignored; it cannot become the current proposal. Covered by replacement and late-proposal schedules.",
    "LateProposalErrorIgnored": "A proposal error from an older generation or replaced owner is ignored; it cannot retire the current proposal. Covered by replacement and late-proposal schedules.",
    "late-reconcile-ignored": "A reconcile response from an older generation, explorer, or workspace fingerprint is ignored; the result identity guard rejects it. Covered by the reconcile identity schedule."
  },
  "schedules": {
    "reconcile-recovery": {
