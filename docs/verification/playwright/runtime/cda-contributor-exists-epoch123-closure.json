        "lines": "739-742",
        "finding": "Existing mutation flow calls queryOwner.pauseAndDrain before changing related state."
      },
      {
        "path": "ui/packages/loom-ui/src/features/ExplorerBuilder/BuilderWorkspace.tsx",
        "lines": "3481-3486",
        "finding": "Proposal-panel Cancel clears proposal/editor state without pausing and draining the related-choice query owner."
      }
