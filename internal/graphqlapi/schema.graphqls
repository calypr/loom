type Query {
  dataframeBuilderIntrospection(
    input: DataframeBuilderIntrospectionInput!
  ): DataframeBuilderIntrospection!
}

scalar JSON

type Mutation {
  runFhirDataframe(
    input: FhirDataframeInput!
    limit: Int = 25
  ): FhirDataframeResult!
}

input DataframeBuilderIntrospectionInput {
  project: String!
  rootResourceType: String!
  authResourcePaths: [String!]
  includePivotOnlyFields: Boolean = true
}

type DataframeBuilderIntrospection {
  project: String!
  rootResourceType: String!
  authResourcePaths: [String!]!
  root: DataframeResourceHints!
  relatedResources: [DataframeRelatedResourceHints!]!
  traversals: [DataframeTraversalHint!]!
  fields: [DataframeFieldHint!]!
  pivotFields: [DataframeFieldHint!]!
}

type DataframeResourceHints {
  resourceType: String!
  fields: [DataframeFieldHint!]!
  pivotFields: [DataframeFieldHint!]!
  traversals: [DataframeTraversalHint!]!
}

type DataframeRelatedResourceHints {
  viaLabel: String!
  edgeCount: Int!
  target: DataframeResourceHints!
}

type DataframeTraversalHint {
  fromType: String!
  label: String!
  toType: String!
  edgeCount: Int!
}

type DataframeFieldHint {
  resourceType: String!
  fieldRef: String!
  label: String!
  path: String!
  selector: DataframeFieldSelector!
  kind: String!
  docCount: Int!
  sampleCount: Int!
  distinctValues: [String!]!
  distinctTruncated: Boolean!
  pivotCandidate: Boolean!
  pivotKind: String
  pivotColumns: [String!]!
}

type DataframeFieldSelector {
  sourcePath: String
  where: DataframeFieldPredicate
  valuePath: String!
}

type DataframeFieldPredicate {
  path: String!
  op: FhirFieldPredicateOperation!
  value: String!
}

enum FhirPivotKind {
  CODEABLE_CONCEPT_DISPLAY_VALUE
}

input FhirFieldSelectInput {
  name: String!
  fieldRef: String
  selector: FhirFieldSelectorInput
  selectionHint: String
  fallbackFieldRefs: [String!]! = []
  fallbackSelectors: [FhirFieldSelectorInput!]! = []
  valueMode: FhirValueMode! = AUTO
}

input FhirFieldSelectorInput {
  sourcePath: String
  where: FhirFieldPredicateInput
  valuePath: String!
}

input FhirFieldPredicateInput {
  path: String!
  op: FhirFieldPredicateOperation! = CONTAINS
  value: String!
}

enum FhirFieldPredicateOperation {
  CONTAINS
}

enum FhirValueMode {
  AUTO
  FIRST
  ALL
  DISTINCT
}

input FhirPivotInput {
  name: String!
  fieldRef: String
  fhirPath: String
  pivotKind: FhirPivotKind = CODEABLE_CONCEPT_DISPLAY_VALUE
  selectedColumns: [String!]!
  valueFieldRef: String
  valuePath: String
}

enum FhirAggregateOperation {
  COUNT
  COUNT_DISTINCT
  EXISTS
  DISTINCT_VALUES
}

input FhirAggregateInput {
  name: String!
  operation: FhirAggregateOperation!
  fieldRef: String
  fhirPath: String
  predicateFieldRef: String
  predicatePath: String
  predicateEquals: String
  valueMode: FhirValueMode! = AUTO
}

input FhirRepresentativeSliceInput {
  name: String!
  limit: Int!
  whereFieldRef: String
  wherePath: String
  whereEquals: String
  fields: [FhirFieldSelectInput!]! = []
}

input FhirTraversalStepInput {
  edgeLabel: String!
  toResourceType: String!
  alias: String!
  fields: [FhirFieldSelectInput!]! = []
  pivots: [FhirPivotInput!] = []
  aggregates: [FhirAggregateInput!] = []
  slices: [FhirRepresentativeSliceInput!] = []
  traverse: [FhirTraversalStepInput!] = []
}

input FhirDataframeInput {
  project: String!
  authResourcePath: String
  authResourcePaths: [String!]
  rootResourceType: String!
  rootFields: [FhirFieldSelectInput!]
  rootPivots: [FhirPivotInput!]
  rootAggregates: [FhirAggregateInput!]
  rootSlices: [FhirRepresentativeSliceInput!]
  traverse: [FhirTraversalStepInput!]
  limit: Int
  cursor: String
}

type FhirDataframeResult {
  columns: [String!]!
  rows: [FhirDataframeRow!]!
  rowCount: Int!
}

type FhirDataframeRow {
  data: JSON!
}
