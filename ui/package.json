{
  "name": "@calypr/loom-ui-workspace",
  "private": true,
  "workspaces": [
    "packages/loom-ui",
    "apps/demo"
  ],
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "install:clean": "npm install",
    "build": "npm run build --workspace @calypr/loom-ui && npm run build --workspace @calypr/loom-demo",
    "test": "npm run test --workspace @calypr/loom-ui",
    "check-boundaries": "npm run check-boundaries --workspace @calypr/loom-ui"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
