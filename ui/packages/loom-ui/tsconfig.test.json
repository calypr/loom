{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "emitDeclarationOnly": false,
    "rootDir": ".",
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "testSupport/**/*.ts",
    "testSupport/**/*.tsx"
  ],
  "exclude": [
    "dist"
  ]
}
