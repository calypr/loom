{
  "name": "@calypr/loom-ui",
  "version": "0.1.2",
  "description": "Portable Loom Explorer Builder and Viewer components.",
  "type": "module",
  "main": "dist/loom-ui.js",
  "module": "dist/loom-ui.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/loom-ui.js",
      "default": "./dist/loom-ui.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "test": "npm run check-boundaries && vitest run",
    "check-boundaries": "node scripts/check-boundaries.mjs"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@xyflow/react": "^12.10.1",
    "elkjs": "^0.9.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
