FROM node:22.22.0-bookworm-slim

WORKDIR /workspace

COPY package.json package-lock.json ./
COPY packages/loom-ui/package.json packages/loom-ui/package.json
COPY apps/demo/package.json apps/demo/package.json
RUN npm ci

COPY apps/demo/index.html apps/demo/vite.config.ts apps/demo/postcss.config.cjs apps/demo/tailwind.config.cjs ./apps/demo/
COPY apps/demo/src ./apps/demo/src
COPY packages/loom-ui/src ./packages/loom-ui/src

EXPOSE 8080
CMD ["npm", "run", "dev", "--workspace", "@calypr/loom-demo"]
