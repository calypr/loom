{
  "schema": "loom.compiler-oracle/v1",
  "id": "specimen-aggregate-slice",
  "description": "Specimen dataframe combining child count, distinct values, and a bounded representative file slice",
  "tags": [
    "supported",
    "specimen",
    "aggregate",
    "slice",
    "reuse"
  ],
  "limit": 100,
  "project": "oracle-project",
  "recipe": {
    "recipeSchemaVersion": 1,
    "name": "fixture_Specimen",
    "translationVersion": "fixture",
    "outputs": [
      {
        "name": "Specimen",
        "rootResourceType": "Specimen",
        "rowGrain": "specimen",
        "fields": [
          {
            "name": "specimen_id",
            "expr": {
              "select": "id"
            }
          }
        ],
        "traversals": [
          {
            "name": "subject_Specimen",
            "toResourceType": "DocumentReference",
            "alias": "file",
            "aggregates": [
              {
                "name": "file_count",
                "operation": "COUNT"
              },
              {
                "name": "file_formats",
                "operation": "DISTINCT_VALUES",
                "expr": {
                  "select": "type.coding[].display"
                },
                "valueMode": "AUTO"
              }
            ],
            "slices": [
              {
                "name": "representative_files",
                "limit": 3,
                "fields": [
                  {
                    "name": "file_id",
                    "expr": {
                      "select": "id"
                    }
                  },
                  {
                    "name": "file_name",
                    "expr": {
                      "select": "content[].attachment.title"
                    }
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "expected": {
    "supported": true,
    "planProfile": "generic_fhir_graph_recipe",
    "bindVars": {
      "limit": 100,
      "project": "oracle-project"
    },
    "outputColumns": [
      "specimen_id",
      "file__file_count",
      "file__file_formats"
    ]
  }
}
