            "expr": {
              "select": "gender"
            }
          }
        ]
      }
    ]
  },
  "expected": {
    "supported": true,
    "planProfile": "generic_fhir_graph_recipe",
    "queryContains": [
      "FOR root IN @@root_collection",
      "root.payload.gender"
