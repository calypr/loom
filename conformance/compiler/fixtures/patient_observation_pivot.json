        "Columns": ["Tumor Purity", "Hemoglobin"]
      }]
    }]
  },
  "expected": {
    "supported": true,
    "planProfile": "generic_fhir_graph",
    "queryContains": ["MERGE(", "FILTER LENGTH(__pivot_values) > 0"],
    "bindVars": {"project": "oracle-project", "limit": 10},
    "expectedTraversalSets": 1
  }
}
