+package recipeplan
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"github.com/calypr/loom/internal/dataframe/recipe"
+	"os"
+	"path/filepath"
+)
+
+func captureResearchBundle(bundle recipe.Bundle, status string) {
+	dir := os.Getenv("LOOM_COMPILER_RESEARCH_CORPUS")
+	if dir == "" {
+		return
+	}
+	encoded, err := json.Marshal(bundle)
+	if err != nil {
+		panic(err)
+	}
+	hash := sha256.Sum256(encoded)
+	path := filepath.Join(dir, fmt.Sprintf("%s-%x.json", status, hash))
+	file, err := os.OpenFile(path, os.O_CREATE|os.O_EXCL|os.O_WRONLY, 0600)
+	if os.IsExist(err) {
+		return
+	}
+	if err != nil {
+		panic(err)
+	}
+	if _, err = file.Write(encoded); err != nil {
+		panic(err)
+	}
+	if err = file.Close(); err != nil {
+		panic(err)
+	}
+}
